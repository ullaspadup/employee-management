# Copy to .env and replace every placeholder with local-only values.
# Keep POSTGRES_PASSWORD URL-safe (letters, numbers, underscore, or hyphen)
# because Compose uses it to form the SQLAlchemy connection URL.
POSTGRES_DB=employee_db
POSTGRES_USER=employee_user
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password

# Compose overrides DATABASE_URL for the backend service to use hostname postgres.
# This localhost URL is for running the backend directly on the host.
DATABASE_URL=postgresql+psycopg://employee_user:replace-with-a-local-url-safe-password@127.0.0.1:5432/employee_db
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
